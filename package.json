{
  "name": "pdfapp",
  "version": "1.2.0",
  "description": "PDFapp - a PDF viewer and editor for researchers",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win dir --x64 && node scripts/copy-exe.js",
    "test": "node test/smoke.cjs",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "ios:sync": "node scripts/build-web.js && npx cap sync ios",
    "ios:open": "node scripts/build-web.js && npx cap sync ios && npx cap open ios",
    "ios:ipa": "bash scripts/build-ipa.sh",
    "update": "bash scripts/update.sh"
  },
  "author": "Uri Simonsohn",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "PDFapp",
  "build": {
    "appId": "com.bdstanley.pdfapp",
    "productName": "PDFapp",
    "files": [
      "main.js",
      "zotero-main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "PDFapp"
    }
  },
  "contributors": [
    "Ben Stanley"
  ]
}
